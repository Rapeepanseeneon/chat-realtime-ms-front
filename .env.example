NEXT_PUBLIC_WS_URL=ws://localhost:3001/ws
NEXT_PUBLIC_API_URL=http://localhost:3001
# For `bun run dev:https`, use wss://localhost:3001/ws and https://localhost:3001.
NEXT_PUBLIC_USE_CURRENT_HOST=false
# Comma-separated hostnames allowed to load Next.js development assets/HMR.
NEXT_ALLOWED_DEV_ORIGINS=localhost
NEXT_PUBLIC_WEBRTC_ICE_SERVERS=stun:stun.l.google.com:19302
# Optional JSON array for STUN/TURN entries with short-lived TURN credentials.
NEXT_PUBLIC_WEBRTC_ICE_SERVERS_JSON=
# Optional development diagnostics for media tracks, SDP direction, ICE and playback.
NEXT_PUBLIC_WEBRTC_DEBUG=false
